استدعاء(.\الوحدات\التعريفات\الشاشة\فريم_بفر.تطبيق)
استدعاء(.\الوحدات\سراج\الخلفية.تطبيق)
استدعاء(.\الوحدات\سراج\قائمة.تطبيق)
استدعاء(.\الوحدات\سراج\مؤشر_الفأرة.تطبيق)
استدعاء(.\الوحدات\سراج\مدير_النوافذ.تطبيق)
استدعاء(.\الوحدات\التطبيقات\اختصارات_سطح_المكتب\طرفية.تطبيق)
استدعاء(.\الوحدات\التطبيقات\الساعة\ساعة.تطبيق)
استدعاء(.\الوحدات\التطبيقات\آلة_حاسبة\آلة_حاسبة.تطبيق)

آخر_ثانية = 255


قب_س  = -1
قب_ص  = -1
قب_زر = -1


دالة(رسم_الشاشة)

    خلفية_ممتلئة(0x0000FF)
    طرفية_ارسم_النافذة()
    ساعة_ارسم_النافذة()
    آلة_حاسبة_ارسم_النافذة()
    رسم_القائمة_الرئيسية()
    مؤشر_الفأرة()
    اعرض()

    ارجع()

نهاية(رسم_الشاشة)


دالة(العرض)

    تهيئة_الخط()
    رسم_الشاشة()

    قب_س  = موضع_س
    قب_ص  = موضع_ص
    قب_زر = زر_الفأرة

    حلقة()

        انتظر(1)
        تغير = 0

        اذا(موضع_س != قب_س)
            تغير = 1
        نهاية_الشرط

        اذا(موضع_ص != قب_ص)
            تغير = 1
        نهاية_الشرط

        اذا(زر_الفأرة != قب_زر)
            تغير = 1
        نهاية_الشرط

        اذا(الوقت_ثانية != آخر_ثانية)
            آخر_ثانية = الوقت_ثانية
            تغير = 1
        نهاية_الشرط

        "" ① آلة الحاسبة أولًا — تستهلك النقرة إن كانت داخلها ""
        حاسبة_استهلكت = آلة_حاسبة_تفاعل()

        اذا(حاسبة_استهلكت = 1)
            تغير = 1
        نهاية_الشرط

        "" ② القائمة ثانيًا — تجد نقرة_الفأرة = 0 إن استهلكتها الحاسبة ""
        قائمة_نتيجة = تفاعل_القائمة_الرئيسية()

        اذا(قائمة_نتيجة != 0)
            تغير = 1
        نهاية_الشرط

        "" ③ سحب النوافذ ""
        النوافذ()

        قب_س  = موضع_س
        قب_ص  = موضع_ص
        قب_زر = زر_الفأرة

        اذا(تغير = 1)
            رسم_الشاشة()
        نهاية_الشرط

    نهاية_الحلقة

    ارجع()

نهاية(العرض)


العرض()
