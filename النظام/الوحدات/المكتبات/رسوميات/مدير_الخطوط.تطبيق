"" ============================================================ ""
"" رسم حرف واحد — يكتب بكسلات عبر بكسل() من فريم بفر            ""
"" رح_رمز: كود ASCII للحرف                                      ""
"" ============================================================ ""
دالة(رسم_حرف, رح_س, رح_ص, رح_رمز, رح_لون)

    "" حماية ضد الخروج عن الشاشة ""
    اذا(رح_س >= عرض_المخزن)
        ارجع()
    نهاية_الشرط

    اذا(رح_ص >= ارتفاع_المخزن)
        ارجع()
    نهاية_الشرط

    اذا(رح_س <= 0 - 8)
        ارجع()
    نهاية_الشرط

    اذا(رح_ص <= 0 - 8)
        ارجع()
    نهاية_الشرط

    "" حساب إزاحة الحرف في جدول الخط ""
    رح_ازاحة = 0

    "" الأرقام 0-9: مواقعها 1..10 في الجدول ""
    اذا(رح_رمز >= 48)
        اذا(رح_رمز <= 57)
            رح_ازاحة = (رح_رمز - 48 + 1) * 8
        نهاية_الشرط
    نهاية_الشرط

    "" الحروف الكبيرة A-Z: مواقعها 11..36 ""
    اذا(رح_رمز >= 65)
        اذا(رح_رمز <= 90)
            رح_ازاحة = (رح_رمز - 65 + 11) * 8
        نهاية_الشرط
    نهاية_الشرط

    "" الحروف الصغيرة a-z: تُحوَّل إلى كبيرة ""
    اذا(رح_رمز >= 97)
        اذا(رح_رمز <= 122)
            رح_رمز   = رح_رمز - 32
            رح_ازاحة = (رح_رمز - 65 + 11) * 8
        نهاية_الشرط
    نهاية_الشرط

    "" ارسم 8 صفوف من الحرف ""
    رح_صف = 0
    حلقة()
        اذا(رح_صف >= 8)
            كسر()
        نهاية_الشرط

        "" اقرأ بايت واحد من جدول الخط (8 بتات أفقية) ""
        رح_بايت = ذاكرة_اقرا8(عنوان_الخط + رح_ازاحة + رح_صف)

        رح_باقي = رح_بايت
        رح_قوة  = 128
        رح_عمود = 0

        حلقة()
            اذا(رح_عمود >= 8)
                كسر()
            نهاية_الشرط

            "" إذا كانت البتة مرتفعة → ارسم بكسل ""
            اذا(رح_باقي >= رح_قوة)

                "" فريم بفر يتولى حساب العنوان والحماية من الحدود ""
                بكسل(رح_س + رح_عمود, رح_ص + رح_صف, رح_لون)

                رح_باقي = رح_باقي - رح_قوة
            نهاية_الشرط

            رح_قوة  = رح_قوة / 2
            رح_عمود = رح_عمود + 1
        نهاية_الحلقة

        رح_صف = رح_صف + 1
    نهاية_الحلقة

    ارجع()

نهاية(رسم_حرف)


"" ============================================================ ""
"" رسم نص كامل — يستدعي رسم_حرف لكل حرف                          ""
"" التباعد الأفقي: 6 بكسل (الحرف 8 بكسل لكن مع تداخل)           ""
"" ============================================================ ""
دالة(رسم_نص, rn_س, rn_ص, rn_نص, rn_لون)

    rn_طول  = طول_النص(rn_نص)
    rn_فهرس = 0

    حلقة()
        اذا(rn_فهرس >= rn_طول)
            كسر()
        نهاية_الشرط

        rn_رمز = حرف_النص(rn_نص, rn_فهرس)
        رسم_حرف(rn_س, rn_ص, rn_رمز, rn_لون)

        rn_س    = rn_س + 6
        rn_فهرس = rn_فهرس + 1
    نهاية_الحلقة

    ارجع()

نهاية(رسم_نص)
