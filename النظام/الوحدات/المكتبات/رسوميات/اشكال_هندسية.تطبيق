دالة(مستطيل_بحدود, س, ص, عرض, ارتفاع, لون_جسم, لون_حد)
    مستطيل(س, ص, عرض, ارتفاع, لون_جسم)
    مستطيل_مفرغ(س, ص, عرض, ارتفاع, 1, لون_حد)
نهاية(مستطيل_بحدود)


"" ============================================================ ""
"" الجذر التربيعي الصحيح                                         ""
"" ============================================================ ""
دالة(جذر_صحيح, ج_ن)

    ج_م = 0

    حلقة()

        اذا((ج_م + 1) * (ج_م + 1) > ج_ن)
            ارجع(ج_م)
        نهاية_الشرط

        ج_م = ج_م + 1

    نهاية_الحلقة

    ارجع(0)

نهاية(جذر_صحيح)


"" ============================================================ ""
"" دائرة مفرغة / ممتلئة / بحدود                                  ""
"" ============================================================ ""
دالة(دائرة, د_س, د_ص, د_نق, د_لون)

    د_نق2 = د_نق * د_نق
    د_ي   = 0 - د_نق

    حلقة()

        اذا(د_ي > د_نق)
            كسر()
        نهاية_الشرط

        د_سx = جذر_صحيح(د_نق2 - د_ي * د_ي)

        بكسل(د_س - د_سx, د_ص + د_ي, د_لون)
        بكسل(د_س + د_سx, د_ص + د_ي, د_لون)

        د_ي = د_ي + 1

    نهاية_الحلقة

نهاية(دائرة)


دالة(دائرة_ممتلئة, د_س, د_ص, د_نق, د_لون)

    د_نق2 = د_نق * د_نق
    د_ي   = 0 - د_نق

    حلقة()

        اذا(د_ي > د_نق)
            كسر()
        نهاية_الشرط

        د_سx = جذر_صحيح(د_نق2 - د_ي * د_ي)
        خط_افقي(د_س - د_سx, د_ص + د_ي, 2 * د_سx + 1, 1, د_لون)

        د_ي = د_ي + 1

    نهاية_الحلقة

نهاية(دائرة_ممتلئة)


دالة(دائرة_بحدود, د_س, د_ص, د_نق, د_لون_جسم, د_لون_حد)
    دائرة_ممتلئة(د_س, د_ص, د_نق - 1, د_لون_جسم)
    دائرة      (د_س, د_ص, د_نق,     د_لون_حد)
نهاية(دائرة_بحدود)
