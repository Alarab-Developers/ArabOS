"" ============================================================ ""
"" مكتبة الأشكال الهندسية                                       ""
""                                                              ""
"" مستطيل()، دائرة() ... تُبنى فوق بدائيات فريم بفر              ""
"" ============================================================ ""

استدعاء(.\الوحدات\التعريفات\الشاشة\فريم_بفر.تطبيق)


"" ------------------------------------------------------------ ""
"" مستطيل مملوء                                                 ""
"" ------------------------------------------------------------ ""
دالة(مستطيل, س, ص, عرض, ارتفاع, لون)

    اذا(عرض <= 0)
        ارجع()
    نهاية_الشرط

    اذا(ارتفاع <= 0)
        ارجع()
    نهاية_الشرط

    "" -------- الاقتصاص على حدود المخزن -------- ""
    م_س0 = س
    م_ص0 = ص
    م_س1 = س + عرض  - 1
    م_ص1 = ص + ارتفاع - 1

    اذا(م_س0 < 0)
        م_س0 = 0
    نهاية_الشرط

    اذا(م_ص0 < 0)
        م_ص0 = 0
    نهاية_الشرط

    اذا(م_س1 >= عرض_المخزن)
        م_س1 = عرض_المخزن - 1
    نهاية_الشرط

    اذا(م_ص1 >= ارتفاع_المخزن)
        م_ص1 = ارتفاع_المخزن - 1
    نهاية_الشرط

    اذا(م_س0 > م_س1)
        ارجع()
    نهاية_الشرط

    اذا(م_ص0 > م_ص1)
        ارجع()
    نهاية_الشرط

    "" -------- عرض كل صف بنداء واحد على فريم بفر -------- ""
    م_عرض_صف = م_س1 - م_س0 + 1
    م_ي      = م_ص0

    حلقة()

        اذا(م_ي > م_ص1)
            كسر()
        نهاية_الشرط

        صف(م_س0, م_ي, م_عرض_صف, لون)

        م_ي = م_ي + 1

    نهاية_الحلقة

نهاية(مستطيل)


