"" ============================================================ ""
"" مكتبة الطباعة                                                ""
""                                                              ""
"" تعتمد على مكتبة فريم_بفر للرسم الفعلي                        ""
"" تحتفظ بمؤشر داخلي يتقدم تلقائيًا مع كل طباعة                  ""
""                                                              ""
"" الاستخدام:                                                    ""
""   اطبع("نص")                ← طباعة عند المؤشر                ""
""   اطبع_سطر("نص")            ← طباعة + انتقال لسطر جديد       ""
""   اطبع_عند(س, ص, "نص")      ← طباعة عند موضع محدد            ""
""   طباعة_ضبط_الموضع(س, ص)    ← تحريك المؤشر يدويًا             ""
""   طباعة_ضبط_اللون(لون)      ← تغيير لون الطباعة               ""
""   طباعة_مسح_الشاشة(لون)     ← مسح الشاشة وإعادة المؤشر        ""
"" ============================================================ ""

استدعاء(.\الوحدات\التعريفات\الشاشة\فريم_بفر.تطبيق)


"" ============================================================ ""
"" حالة المؤشر العامة                                            ""
"" ============================================================ ""
مؤشر_طباعة_س     = 8
مؤشر_طباعة_ص     = 8
مؤشر_طباعة_لون   = 0xFFFFFF
مؤشر_طباعة_هامش  = 8
مؤشر_طباعة_سطر   = 10
مؤشر_طباعة_س_حرف = 6


"" ============================================================ ""
"" ضبط الموضع يدويًا                                              ""
"" ============================================================ ""
دالة(طباعة_ضبط_الموضع, س, ص)
    مؤشر_طباعة_س = س
    مؤشر_طباعة_ص = ص
نهاية(طباعة_ضبط_الموضع)


"" ============================================================ ""
"" ضبط اللون                                                     ""
"" ============================================================ ""
دالة(طباعة_ضبط_اللون, لون)
    مؤشر_طباعة_لون = لون
نهاية(طباعة_ضبط_اللون)


"" ============================================================ ""
"" إعادة المؤشر إلى الهامش وانتقال لسطر جديد                     ""
"" ============================================================ ""
دالة(طباعة_سطر_جديد)
    مؤشر_طباعة_س = مؤشر_طباعة_هامش
    مؤشر_طباعة_ص = مؤشر_طباعة_ص + مؤشر_طباعة_سطر
نهاية(طباعة_سطر_جديد)


"" ============================================================ ""
"" الطباعة الأساسية — ترسم النص عند المؤشر ثم تُقدّمه            ""
""                                                              ""
"" التفاف تلقائي: إذا تجاوز المؤشر حافة الشاشة ينتقل لسطر جديد ""
"" ============================================================ ""
دالة(اطبع, نص)

    "" ارسم النص عند الموضع الحالي ""
    رسم_نص(مؤشر_طباعة_س, مؤشر_طباعة_ص, نص, مؤشر_طباعة_لون)

    "" احسب عدد الحروف أولًا في سطر منفصل ""
    عدد_حروف = طول_النص(نص)

    "" ثم قدّم المؤشر باستخدام المتغير الوسيط ""
    مؤشر_طباعة_س = مؤشر_طباعة_س + عدد_حروف * مؤشر_طباعة_س_حرف

    "" التفاف تلقائي عند حافة الشاشة ""
    اذا(مؤشر_طباعة_س + مؤشر_طباعة_س_حرف > عرض_الشاشة)
        مؤشر_طباعة_س = مؤشر_طباعة_هامش
        مؤشر_طباعة_ص = مؤشر_طباعة_ص + مؤشر_طباعة_سطر
    نهاية_الشرط

    ارجع()

نهاية(اطبع)


"" ============================================================ ""
"" طباعة + سطر جديد                                              ""
"" ============================================================ ""
دالة(اطبع_سطر, نص)
    اطبع(نص)
    طباعة_سطر_جديد()
    ارجع()
نهاية(اطبع_سطر)


"" ============================================================ ""
"" طباعة عند موضع محدد (لا يعتمد على المؤشر)                    ""
"" ============================================================ ""
دالة(اطبع_عند, س, ص, نص)
    رسم_نص(س, ص, نص, مؤشر_طباعة_لون)
    ارجع()
نهاية(اطبع_عند)


"" ============================================================ ""
"" طباعة عند موضع محدد بلون محدد                                 ""
"" ============================================================ ""
دالة(اطبع_عند_بلون, س, ص, نص, لون)
    رسم_نص(س, ص, نص, لون)
    ارجع()
نهاية(اطبع_عند_بلون)


"" ============================================================ ""
"" مسح الشاشة وإعادة المؤشر إلى البداية                          ""
"" ============================================================ ""
دالة(طباعة_مسح_الشاشة, لون)
    خلفية_ممتلئة(لون)
    مؤشر_طباعة_س = مؤشر_طباعة_هامش
    مؤشر_طباعة_ص = مؤشر_طباعة_هامش
    ارجع()
نهاية(طباعة_مسح_الشاشة)
