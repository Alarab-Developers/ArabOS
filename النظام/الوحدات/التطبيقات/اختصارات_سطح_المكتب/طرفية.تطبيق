استدعاء(.\الوحدات\سراج\مدير_النوافذ.تطبيق)


مؤشر_النافذة = 0


دالة(طرفية_تهيئة)

    اذا(مؤشر_النافذة != 0)
        ارجع()
    نهاية_الشرط

    مؤشر_النافذة = ذاكرة_خصص(40)
    انشاء_نافذة(مؤشر_النافذة, 200, 120, 520, 340, 30, 0x404040, 0x000000)
    اضف_نافذة(مؤشر_النافذة)

    ارجع()

نهاية(طرفية_تهيئة)


دالة(طرفية_مفتوحة)

    اذا(مؤشر_النافذة = 0)
        ارجع(0)
    نهاية_الشرط
    ارجع(1)

نهاية(طرفية_مفتوحة)


دالة(طرفية_ارسم_النافذة)

    اذا(مؤشر_النافذة = 0)
        ارجع()
    نهاية_الشرط

    "" 1) الإطار + شريط العنوان ""
    رسم_نافذة(مؤشر_النافذة, "terminal")

    "" 2) قراءة إحداثيات النافذة من الذاكرة ""
    ن_س      = ذاكرة_اقرا32(مؤشر_النافذة + 0)
    ن_ص      = ذاكرة_اقرا32(مؤشر_النافذة + 4)
    ن_عرض    = ذاكرة_اقرا32(مؤشر_النافذة + 8)
    ن_ارتفاع = ذاكرة_اقرا32(مؤشر_النافذة + 12)
    ن_اطار   = ذاكرة_اقرا32(مؤشر_النافذة + 16)

    "" 3) محتوى الطرفية يبدأ بعد شريط العنوان ""
    مح_س = ن_س + 8
    مح_ص = ن_ص + ن_اطار + 8

    "" 4) سطر الدعوة ""
    رسم_نص(مح_س, مح_ص, ">", 0x40FF40)

    "" 5) (لاحقًا) ارسم الأوامر والنتائج هنا ""

    ارجع()

نهاية(طرفية_ارسم_النافذة)


دالة(طرفية_شغل)

    طرفية_تهيئة()

    ارجع()

نهاية(طرفية_شغل)
