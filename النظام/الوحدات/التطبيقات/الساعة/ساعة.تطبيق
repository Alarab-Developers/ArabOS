"" ============================================================ ""
"" تطبيق الساعة — عرض الوقت الحقيقي                             ""
"" ============================================================ ""

استدعاء(.\الوحدات\المكتبات\رسوميات\اشكال_هندسية.تطبيق)
استدعاء(.\الوحدات\سراج\مؤشر_الفأرة.تطبيق)
استدعاء(.\الوحدات\سراج\مدير_النوافذ.تطبيق)


"" ---- ثوابت النافذة ---- ""
ن_س    = 380
ن_ص    = 200
ن_عرض  = 260
ن_ارتفاع = 160
ن_اطار = 24
ن_لون_اطار = 0x2F6FBF
ن_لون_جسم  = 0x1A1A2A


"" ============================================================ ""
"" ارسم رقمًا بخانتين (00 - 99) مع صفر بادئ                       ""
"" ============================================================ ""
دالة(ارسم_خانتين, س, ص, قيمة, لون)

    عشرات = قيمة / 10
    آحاد  = قيمة - عشرات * 10

    "" ارسم العشرات ""
    اذا(عشرات = 0)
        رسم_نص(س, ص, "0", لون)
    نهاية_الشرط
    اذا(عشرات = 1)
        رسم_نص(س, ص, "1", لون)
    نهاية_الشرط
    اذا(عشرات = 2)
        رسم_نص(س, ص, "2", لون)
    نهاية_الشرط
    اذا(عشرات = 3)
        رسم_نص(س, ص, "3", لون)
    نهاية_الشرط
    اذا(عشرات = 4)
        رسم_نص(س, ص, "4", لون)
    نهاية_الشرط
    اذا(عشرات = 5)
        رسم_نص(س, ص, "5", لون)
    نهاية_الشرط
    اذا(عشرات = 6)
        رسم_نص(س, ص, "6", لون)
    نهاية_الشرط
    اذا(عشرات = 7)
        رسم_نص(س, ص, "7", لون)
    نهاية_الشرط
    اذا(عشرات = 8)
        رسم_نص(س, ص, "8", لون)
    نهاية_الشرط
    اذا(عشرات = 9)
        رسم_نص(س, ص, "9", لون)
    نهاية_الشرط

    "" ارسم الآحاد ""
    س2 = س + 6

    اذا(آحاد = 0)
        رسم_نص(س2, ص, "0", لون)
    نهاية_الشرط
    اذا(آحاد = 1)
        رسم_نص(س2, ص, "1", لون)
    نهاية_الشرط
    اذا(آحاد = 2)
        رسم_نص(س2, ص, "2", لون)
    نهاية_الشرط
    اذا(آحاد = 3)
        رسم_نص(س2, ص, "3", لون)
    نهاية_الشرط
    اذا(آحاد = 4)
        رسم_نص(س2, ص, "4", لون)
    نهاية_الشرط
    اذا(آحاد = 5)
        رسم_نص(س2, ص, "5", لون)
    نهاية_الشرط
    اذا(آحاد = 6)
        رسم_نص(س2, ص, "6", لون)
    نهاية_الشرط
    اذا(آحاد = 7)
        رسم_نص(س2, ص, "7", لون)
    نهاية_الشرط
    اذا(آحاد = 8)
        رسم_نص(س2, ص, "8", لون)
    نهاية_الشرط
    اذا(آحاد = 9)
        رسم_نص(س2, ص, "9", لون)
    نهاية_الشرط

نهاية(ارسم_خانتين)


"" ============================================================ ""
"" ارسم نافذة الساعة (يُستدعى كل إطار)                            ""
"" ============================================================ ""
دالة(ساعة_ارسم_النافذة)

    "" الإطار ""
    مستطيل(ن_س, ن_ص, ن_عرض, ن_ارتفاع, ن_لون_جسم)
    مستطيل(ن_س, ن_ص, ن_عرض, ن_اطار, ن_لون_اطار)
    مستطيل_مفرغ(ن_س, ن_ص, ن_عرض, ن_ارتفاع, 1, 0x6080C0)

    "" عنوان ""
    رسم_نص(ن_س + 8, ن_ص + 8, "clock", 0xFFFFFF)

    "" الوقت بالساعات:الدقائق:الثواني ""
    ث = الوقت_ساعة
    د = الوقت_دقيقة
    س = الوقت_ثانية

    "" مركز أفقي للساعة ""
    نص_س = ن_س + (ن_عرض - 8 * 6) / 2 - 12
    نص_ص = ن_ص + 60

    ارسم_خانتين(نص_س,       نص_ص, ث, 0x4AFF4A)
    رسم_نص   (نص_س + 12,    نص_ص, ":", 0xFFFFFF)
    ارسم_خانتين(نص_س + 20,  نص_ص, د, 0x4AFF4A)
    رسم_نص   (نص_س + 32,    نص_ص, ":", 0xFFFFFF)
    ارسم_خانتين(نص_س + 40,  نص_ص, س, 0xFFFF4A)

    "" التاريخ أسفل ""
    رسم_نص(ن_س + 8, ن_ص + ن_ارتفاع - 20, "date", 0x8080A0)

    ي = الوقت_يوم
    ش = الوقت_شهر
    سن = الوقت_سنة

    تاريخ_س = ن_س + 60
    تاريخ_ص = ن_ص + ن_ارتفاع - 20
    ارسم_خانتين(تاريخ_س,       تاريخ_ص, ي,  0xFFFFFF)
    رسم_نص   (تاريخ_س + 12,    تاريخ_ص, "/", 0x808080)
    ارسم_خانتين(تاريخ_س + 20,  تاريخ_ص, ش,  0xFFFFFF)
    رسم_نص   (تاريخ_س + 32,    تاريخ_ص, "/", 0x808080)
    رسم_نص   (تاريخ_س + 40,    تاريخ_ص, "20", 0xFFFFFF)
    ارسم_خانتين(تاريخ_س + 52,  تاريخ_ص, سن, 0xFFFFFF)

نهاية(ساعة_ارسم_النافذة)
