
# =========================================================
# ArabFS Module Makefile
# =========================================================

CC      = gcc
LD      = ld

BUILD   = ../build
MODULES = ../modules

CFLAGS  = -m64 \
           -mno-red-zone \
           -mcmodel=large \
           -ffreestanding \
           -fno-stack-protector \
           -fno-pie \
           -fno-pic \
           -Wall \
           -Wextra \
           -Wno-unused-function \
           -I. \
           -I.. \
           -I../النظام

# =========================================================
# OBJECTS
# =========================================================

ARABFS_OBJS = \
$(BUILD)/نظام_العرب.o \
$(BUILD)/المجلدات.o \
$(BUILD)/المسارات.o \
$(BUILD)/القراءة.o \
$(BUILD)/الكتابة.o \
$(BUILD)/الملفات.o \
$(BUILD)/التهيئة.o \
$(BUILD)/العقدة.o \
$(BUILD)/الكتلة.o \
$(BUILD)/التعريف_العام.o

# =========================================================
# ALL
# =========================================================

all: dirs arabfs.elf

# =========================================================
# DIRS
# =========================================================

dirs:
	mkdir -p $(BUILD)
	mkdir -p $(MODULES)

# =========================================================
# COMPILE
# =========================================================

$(BUILD)/نظام_العرب.o:
	$(CC) $(CFLAGS) -c \
	../النظام/التعريفات/أنظمة_الملفات/نظام_العرب/نظام_العرب.c \
	-o $@

$(BUILD)/المجلدات.o:
	$(CC) $(CFLAGS) -c \
	../النظام/التعريفات/أنظمة_الملفات/نظام_العرب/المجلدات/المجلدات.c \
	-o $@

$(BUILD)/المسارات.o:
	$(CC) $(CFLAGS) -c \
	../النظام/التعريفات/أنظمة_الملفات/نظام_العرب/المسارات/المسارات.c \
	-o $@

$(BUILD)/القراءة.o:
	$(CC) $(CFLAGS) -c \
	../النظام/التعريفات/أنظمة_الملفات/نظام_العرب/القراءة/القراءة.c \
	-o $@

$(BUILD)/الكتابة.o:
	$(CC) $(CFLAGS) -c \
	../النظام/التعريفات/أنظمة_الملفات/نظام_العرب/الكتابة/الكتابة.c \
	-o $@

$(BUILD)/الملفات.o:
	$(CC) $(CFLAGS) -c \
	../النظام/التعريفات/أنظمة_الملفات/نظام_العرب/الملفات/الملفات.c \
	-o $@

$(BUILD)/التهيئة.o:
	$(CC) $(CFLAGS) -c \
	../النظام/التعريفات/أنظمة_الملفات/نظام_العرب/التهيئة/التهيئة.c \
	-o $@

$(BUILD)/العقدة.o:
	$(CC) $(CFLAGS) -c \
	../النظام/التعريفات/أنظمة_الملفات/نظام_العرب/العقدة/العقدة.c \
	-o $@

$(BUILD)/الكتلة.o:
	$(CC) $(CFLAGS) -c \
	../النظام/التعريفات/أنظمة_الملفات/نظام_العرب/الكتلة/الكتلة.c \
	-o $@

$(BUILD)/التعريف_العام.o:
	$(CC) $(CFLAGS) -c \
	../النظام/التعريفات/أنظمة_الملفات/نظام_العرب/التعريف_العام/التعريف_العام.c \
	-o $@

# =========================================================
# LINK ELF MODULE
# =========================================================

arabfs.elf: $(ARABFS_OBJS)

	$(LD) -m elf_x86_64 -r \
	-o $(MODULES)/arabfs.elf \
	$(ARABFS_OBJS)

# =========================================================
# CLEAN
# =========================================================

clean:

	rm -f $(BUILD)/نظام_العرب.o
	rm -f $(BUILD)/المجلدات.o
	rm -f $(BUILD)/المسارات.o
	rm -f $(BUILD)/القراءة.o
	rm -f $(BUILD)/الكتابة.o
	rm -f $(BUILD)/الملفات.o
	rm -f $(BUILD)/التهيئة.o
	rm -f $(BUILD)/العقدة.o
	rm -f $(BUILD)/الكتلة.o
	rm -f $(BUILD)/التعريف_العام.o

	rm -f $(MODULES)/arabfs.elf

# =========================================================
# REBUILD
# =========================================================

rebuild: clean all
